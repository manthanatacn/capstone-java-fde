# HealthDekho configuration. Every line is an environment variable.
#
# Local:  copy this file to `.env` in the repo root (or backend/). The API reads it on start-up.
#         Real environment variables always override the file.
# AWS Elastic Beanstalk: enter the same names under Configuration > Updates, monitoring and logging >
#         Environment properties (or `eb setenv NAME=value ...`). Do not upload a .env file there.
#
# Write values without quotes. Leave a line commented out to use the default.

# --- Profile -----------------------------------------------------------------
# dev (default): demo data, dev defaults below. prod: no demo data, no defaults for secrets.
# SPRING_PROFILES_ACTIVE=prod

# --- Database (required in prod) --------------------------------------------
# Dev defaults match dev/docker-compose.yml. On AWS, use the RDS endpoint.
# DB_URL=jdbc:postgresql://localhost:5432/healthdekho
# DB_USERNAME=healthdekho
# DB_PASSWORD=healthdekho

# --- Security (required in prod) --------------------------------------------
# At least 32 characters. Generate one with: openssl rand -base64 48
# JWT_SECRET=
# JWT_TTL=2h

# --- Web ---------------------------------------------------------------------
# Port the API listens on. Beanstalk uses 5000 (already set by deploy/beanstalk/.ebextensions).
# PORT=8080
# Only needed when the web app is served from a different origin than the API.
# CORS_ORIGINS=http://localhost:5173

# --- AI recommendations (optional) ------------------------------------------
# Without a key, recommendations use the rule-based ranker. Any OpenAI-compatible endpoint works.
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com
# AI_COMPLETIONS_PATH=/v1/chat/completions
# AI_MODEL=gpt-4o-mini
