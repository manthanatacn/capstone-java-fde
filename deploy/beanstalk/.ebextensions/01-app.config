# Non-secret settings that every HealthDekho environment needs.
# Values set in the console or with `eb setenv` override these.
# Secrets (DB_PASSWORD, JWT_SECRET, AI_API_KEY) do NOT belong in this file: see docs/deployment.md.
option_settings:
  aws:elasticbeanstalk:application:environment:
    SPRING_PROFILES_ACTIVE: prod
    PORT: 5000            # nginx on the instance forwards to this port
  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: /    # served by the app itself (the bundled web page)
